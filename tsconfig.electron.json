{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
   
    "esModuleInterop": true,
    "skipLibCheck": true,
    
    
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "electron/**/*",
    "shared/**/*",
  ]
}
